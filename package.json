{
  "name": "dsh-memory-tree",
  "version": "0.1.0",
  "description": "Memory tree for DeepSeek Harness: collects your session logs into a local SQLite memory, lets it fade with time, and renders it as a tree you can drill into.",
  "type": "module",
  "license": "MIT",
  "author": "dtr12",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DDD33-car/dsh-memory-tree.git"
  },
  "homepage": "https://github.com/DDD33-car/dsh-memory-tree#readme",
  "bugs": {
    "url": "https://github.com/DDD33-car/dsh-memory-tree/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "visualization",
    "sqlite"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src/**/*.mjs",
    "src/viewer.html",
    "src/defaults/*.json",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
